{
  "provider": {
    "type": "mock",
    "model": "corporate-agent-test-model"
  },
  "security": {
    "isolationMode": "strict",
    "allowInternet": false,
    "allowedHosts": [],
    "deniedFiles": ["**/.env", "**/*.key", "**/*.pem"]
  },
  "execution": {
    "maxIterations": 3,
    "maxTokens": 4000,
    "timeoutMs": 120000
  },
  "memory": {
    "enabled": true
  },
  "context": {
    "maxFiles": 4,
    "maxChars": 12000
  }
}

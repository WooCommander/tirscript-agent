{
  "provider": {
    "type": "mock",
    "model": "corporate-agent-test-model"
  },
  "security": {
    "isolationMode": "strict",
    "allowInternet": false,
    "allowedHosts": [],
    "deniedFiles": ["**/.env", "**/*.key", "**/*.pem"]
  },
  "execution": {
    "maxIterations": 12,
    "maxTokens": 12000,
    "timeoutMs": 900000
  },
  "context": {
    "maxFiles": 6,
    "maxChars": 30000
  }
}
